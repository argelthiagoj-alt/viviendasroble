# Contenedor de Google Tag Manager. Formato: GTM-XXXXXXX
# Sin este valor el sitio funciona igual, simplemente no carga GTM.
# GA4 NO se configura acá: se conecta dentro de GTM.
NEXT_PUBLIC_GTM_ID=

# Poner en "true" para ver cada evento por consola durante el desarrollo.
# Dejar vacío en producción.
NEXT_PUBLIC_ANALYTICS_DEBUG=
